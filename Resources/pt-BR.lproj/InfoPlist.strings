/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "O Lattice usa a Automação para mover arquivos, enviar itens ao Lixo, abrir comandos solicitados e controlar a reprodução nos seus apps de mídia.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "O Lattice usa o áudio de cada app para ajustar o volume no mixer, para mover as barras de música da Dynamic Island e para incluir o som do Mac nas gravações de tela que você iniciar. Nada sai do seu Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "O Lattice usa o Bluetooth apenas para ler a bateria dos periféricos conectados. Nada sai do seu Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "O Lattice grava seu microfone apenas quando você o ativa em uma gravação de tela. O áudio fica no seu Mac, a menos que você escolha criar um link temporário.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "O Lattice usa a câmera ao abrir a prévia ou ativar a sobreposição em uma gravação de tela. O vídeo só é gravado quando você o ativa e fica no Mac, a menos que escolha compartilhá-lo.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "O Lattice consulta metadados locais em Downloads para revisar, organizar ou mover para a Lixeira apenas os arquivos confirmados do WhatsApp que você escolher. A Limpeza também procura capturas de tela esquecidas quando você as salva aqui.";

