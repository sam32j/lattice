/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Lattice usa Automazione per spostare file, inviare elementi al Cestino, aprire i comandi richiesti e controllare la riproduzione nelle tue app multimediali.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Lattice usa l'audio di ogni app per regolarne il volume nel mixer, per muovere le barre musicali di Dynamic Island e per includere l'audio del Mac nelle registrazioni dello schermo che avvii. Nulla lascia il tuo Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Lattice usa il Bluetooth solo per leggere la batteria delle periferiche connesse. Nulla lascia il tuo Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Lattice registra il microfono solo quando lo attivi per una registrazione dello schermo. L’audio resta sul tuo Mac, a meno che tu scelga di creare un link temporaneo.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Lattice usa la fotocamera quando apri l’anteprima o attivi la sovrapposizione per una registrazione dello schermo. Il video viene registrato solo se lo attivi e resta sul Mac, a meno che tu scelga di condividerlo.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Lattice controlla i metadati locali in Download per esaminare, organizzare o spostare nel Cestino solo i file WhatsApp confermati scelti da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui.";

