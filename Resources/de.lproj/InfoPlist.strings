/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Lattice verwendet Automation, um Dateien zu verschieben, Objekte in den Papierkorb zu legen, angeforderte Befehle zu öffnen und die Wiedergabe in deinen Medienapps zu steuern.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Lattice nutzt den Ton jeder App, um ihre Lautstärke im Mixer zu regeln, die Musikbalken von Dynamic Island zu bewegen und den Ton des Mac in die Bildschirmaufnahmen aufzunehmen, die du startest. Nichts verlässt deinen Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Lattice verwendet Bluetooth nur, um den Akkustand verbundener Peripheriegeräte zu lesen. Nichts verlässt deinen Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Lattice nimmt dein Mikrofon nur auf, wenn du es für eine Bildschirmaufnahme einschaltest. Der Ton bleibt auf deinem Mac, außer du erstellst einen temporären Link.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Lattice nutzt die Kamera, wenn du die Vorschau öffnest oder die Kameraüberlagerung für eine Bildschirmaufnahme aktivierst. Kameravideo wird nur nach Aktivierung aufgenommen und bleibt auf deinem Mac, sofern du es nicht teilst.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Lattice prüft lokale Metadaten in Downloads, um nur ausgewählte bestätigte WhatsApp-Dateien zu prüfen, zu organisieren oder in den Papierkorb zu verschieben. Aufräumen sucht außerdem nach vergessenen Bildschirmfotos, wenn du sie hier speicherst.";

/* macOS user-selected organizer destination prompts. */
