/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Lattice использует Автоматизацию для перемещения файлов, отправки объектов в Корзину, открытия запрошенных команд и управления воспроизведением в ваших медиаприложениях.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Lattice использует звук каждого приложения, чтобы регулировать его громкость в микшере, двигать музыкальные полоски Dynamic Island и добавлять звук Mac в записи экрана, которые вы запускаете. Ничего не покидает ваш Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Lattice использует Bluetooth только для чтения заряда подключённых периферийных устройств. Ничего не покидает ваш Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Lattice записывает микрофон, только когда вы включаете его для записи экрана. Звук остаётся на вашем Mac, если только вы не создадите временную ссылку.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Lattice использует камеру при открытии предпросмотра или включении её наложения для записи экрана. Видео записывается только с вашего разрешения и остаётся на Mac, если вы не решите им поделиться.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Lattice проверяет локальные метаданные в Загрузках, чтобы просматривать, упорядочивать или перемещать в Корзину только выбранные вами подтверждённые файлы WhatsApp. Очистка также ищет забытые снимки экрана, если вы сохраняете их сюда.";

